---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import { ArrowLeft, Link } from "@lucide/astro";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { SITE_TITLE, withBase } from "../consts";
import { getBlogPosts } from "../lib/posts";
type Props = CollectionEntry<"blog">["data"] & { headings?: MarkdownHeading[] };
const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  cover,
  category,
  headings = [],
} = Astro.props;
const related = (await getBlogPosts())
  .filter((post) => post.data.title !== title)
  .slice(0, 2);
---

<!doctype html>
<html lang="zh-CN" id="top">
  <head>
    <BaseHead
      title={`${title} · ${SITE_TITLE}`}
      description={description}
      image={cover ? withBase(cover) : heroImage}
    />
  </head>
  <body>
    <div class="progress" aria-hidden="true"></div>
    <Header />
    <main id="main" class="wrap reading-layout">
      <article>
        <a class="back-link" href={withBase("blog/")}>
          <ArrowLeft size={15} /> 全部文章
        </a>
        <header class="article-header">
          <div class="meta">
            <a
              class="category"
              href={`${withBase("blog/")}?category=${encodeURIComponent(category)}`}
            >
              {category}
            </a>
            <FormattedDate date={pubDate} />
            {updatedDate && (
              <span>
                更新于 <FormattedDate date={updatedDate} />
              </span>
            )}
          </div>
          <h1>{title}</h1>
          <p class="article-description">{description}</p>
        </header>
        {cover ? (
          <img
            class="article-image"
            src={withBase(cover)}
            alt=""
            width="1600"
            height="900"
          />
        ) : (
          heroImage && (
            <Image
              class="article-image"
              src={heroImage}
              alt=""
              width={1200}
              height={600}
            />
          )
        )}
        <div class="prose">
          <slot />
        </div>
        <div class="article-actions">
          <a class="back-link" style="margin:0" href={withBase("blog/")}>
            <ArrowLeft size={15} /> 返回文章列表
          </a>
          <button class="copy-link" id="copy-link">
            <Link size={14} />
            <span>复制文章链接</span>
          </button>
        </div>
        <p id="copy-status" class="meta" role="status" aria-live="polite"></p>
        <section class="related">
          <h2>接着读</h2>
          {related.map((post) => (
            <a href={withBase(`blog/${post.id}/`)}>{post.data.title} →</a>
          ))}
        </section>
      </article>
      <aside class="toc" aria-label="文章目录">
        <h2>本文目录</h2>
        {headings
          .filter((heading) => heading.depth === 2 || heading.depth === 3)
          .map((heading) => (
            <a
              class:list={{ sub: heading.depth === 3 }}
              href={`#${heading.slug}`}
            >
              {heading.text}
            </a>
          ))}
        <a href="#top">回到顶部 ↑</a>
      </aside>
    </main>
    <Footer />
    <script>
      document
        .querySelector("#copy-link")
        ?.addEventListener("click", async () => {
          const status = document.querySelector("#copy-status")!;
          try {
            await navigator.clipboard.writeText(location.href.split("#")[0]);
            status.textContent = "链接已复制";
          } catch {
            status.textContent = `请复制地址栏中的链接：${location.href.split("#")[0]}`;
          }
        });
      const progress = document.querySelector<HTMLElement>(".progress");
      function updateProgress() {
        const height = document.documentElement.scrollHeight - innerHeight;
        if (progress)
          progress.style.width = `${height > 0 ? Math.min(100, (scrollY / height) * 100) : 100}%`;
      }
      addEventListener("scroll", updateProgress, { passive: true });
      addEventListener("resize", updateProgress);
      updateProgress();
    </script>
  </body>
</html>
