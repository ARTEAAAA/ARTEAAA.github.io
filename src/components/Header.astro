---
import { Moon, Sun, Search } from "@lucide/astro";
import { SITE_TITLE, withBase } from "../consts";
const current = Astro.url.pathname.replace(/\/$/, "");
const links = [
  ["", "首页"],
  ["blog/", "文章"],
  ["archive/", "归档"],
  ["about/", "关于"],
];
---

<a class="skip" href="#main">
  跳到正文
</a>
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={withBase()}>
      <span class="brand-mark">ar.</span>
      <span>{SITE_TITLE}</span>
    </a>
    <nav class="site-nav" aria-label="主导航">
      {links.map(([path, label]) => (
        <a
          href={withBase(path)}
          aria-current={
            (
              path
                ? current.startsWith(withBase(path).replace(/\/$/, ""))
                : current === withBase().replace(/\/$/, "")
            )
              ? "page"
              : undefined
          }
        >
          {label}
        </a>
      ))}
    </nav>
    <div class="header-tools">
      <a
        class="icon-button header-search"
        href={withBase("blog/#search")}
        title="搜索文章"
        aria-label="搜索文章"
      >
        <Search size={18} />
      </a>
      <button
        id="theme-toggle"
        class="icon-button"
        type="button"
        title="切换深色模式"
        aria-label="切换深色模式"
        aria-pressed="false"
      >
        <Moon class="moon-icon" size={18} />
        <Sun class="sun-icon" size={18} />
      </button>
    </div>
  </div>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>("#theme-toggle");
  function syncTheme() {
    const dark = document.documentElement.dataset.theme === "dark";
    button?.setAttribute("aria-pressed", String(dark));
    button?.setAttribute("aria-label", dark ? "切换浅色模式" : "切换深色模式");
    button?.setAttribute("title", dark ? "切换浅色模式" : "切换深色模式");
  }
  syncTheme();
  button?.addEventListener("click", () => {
    const theme =
      document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = theme;
    try {
      localStorage.setItem("ar-theme", theme);
    } catch {}
    syncTheme();
  });
</script>
