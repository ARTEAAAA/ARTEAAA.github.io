---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import FormattedDate from "./FormattedDate.astro";
import { withBase } from "../consts";
interface Props {
  post: CollectionEntry<"blog">;
  searchable?: boolean;
}
const { post, searchable = false } = Astro.props;
const minutes = Math.max(1, Math.ceil((post.body?.length ?? 0) / 700));
---

<article
  class="post-row"
  data-post={searchable || undefined}
  data-category={post.data.category}
  data-search={
    searchable
      ? `${post.data.title} ${post.data.description} ${post.data.category} ${post.body ?? ""}`.toLowerCase()
      : undefined
  }
>
  <div>
    <div class="meta">
      <span class="category">{post.data.category}</span>
      <FormattedDate date={post.data.pubDate} />
      <span>{minutes} 分钟阅读</span>
    </div>
    <h2>
      <a href={withBase(`blog/${post.id}/`)}>{post.data.title}</a>
    </h2>
    <p>{post.data.description}</p>
  </div>
  {post.data.cover ? (
    <img
      class="post-thumb"
      src={withBase(post.data.cover)}
      alt=""
      width="122"
      height="96"
      loading="lazy"
    />
  ) : (
    post.data.heroImage && (
      <Image
        class="post-thumb"
        src={post.data.heroImage}
        alt=""
        width={244}
        height={192}
        loading="lazy"
      />
    )
  )}
</article>
