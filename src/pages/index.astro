---
import { ArrowUpRight, ArrowRight, Rss, Bookmark } from "@lucide/astro";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PostRow from "../components/PostRow.astro";
import { SITE_TITLE, SITE_DESCRIPTION, withBase } from "../consts";
import { getBlogPosts } from "../lib/posts";
const posts = await getBlogPosts();
const featured = posts.find((post) => post.id === "start-writing") ?? posts[0];
const categories = [...new Set(posts.map((post) => post.data.category))];
---

<!doctype html>
<html lang="zh-CN" id="top">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main id="main" class="wrap">
      <section class="intro">
        <p class="eyebrow">NOTES & THOUGHTS</p>
        <h1>
          AR 的博客<span style="color:var(--accent)">.</span>
        </h1>
        <p>{SITE_DESCRIPTION}</p>
      </section>
      <div class="home-layout">
        <div>
          {featured && (
            <a class="feature" href={withBase(`blog/${featured.id}/`)}>
              <img
                src={withBase("mountains.jpg")}
                alt="阳光下的山峰与层叠山脉"
                width="1600"
                height="900"
                fetchpriority="high"
              />
              <div class="feature-copy">
                <p class="eyebrow">
                  <Bookmark size={13} /> 编辑精选
                </p>
                <h2>{featured.data.title}</h2>
                <p>一段记录，从一个小小的开始。</p>
                <ArrowUpRight class="feature-arrow" size={22} />
              </div>
            </a>
          )}
          <div class="section-heading">
            <h2>最近更新</h2>
            <a href={withBase("blog/")}>
              全部文章 <ArrowRight size={14} />
            </a>
          </div>
          {posts
            .filter((post) => post.id !== featured?.id)
            .slice(0, 4)
            .map((post) => (
              <PostRow post={post} />
            ))}
        </div>
        <aside class="sidebar" aria-label="博客信息">
          <section class="side-section">
            <div class="profile-avatar">ar.</div>
            <h2>你好，我是 AR。</h2>
            <p>把想法写下来，让日常有迹可循。欢迎来到我的一小片互联网。</p>
            <a class="text-link" href={withBase("about/")}>
              关于这里 <ArrowUpRight size={14} />
            </a>
            <div class="stats">
              <div>
                <strong>{posts.length.toString().padStart(2, "0")}</strong>
                <span>篇文章</span>
              </div>
              <div>
                <strong>{categories.length.toString().padStart(2, "0")}</strong>
                <span>个分类</span>
              </div>
            </div>
          </section>
          <section class="side-section">
            <h2 class="side-label">按主题阅读</h2>
            {categories.map((category) => (
              <a
                class="category-link"
                href={`${withBase("blog/")}?category=${encodeURIComponent(category)}`}
              >
                {category}
                <span>
                  {posts
                    .filter((post) => post.data.category === category)
                    .length.toString()
                    .padStart(2, "0")}
                </span>
              </a>
            ))}
          </section>
          <section class="side-section">
            <h2>不定期，写一点。</h2>
            <p>新的文章，会在这里与 RSS 中同步更新。</p>
            <a class="text-link" href={withBase("rss.xml")}>
              <Rss size={15} /> 订阅更新
            </a>
          </section>
          <p class="sidebar-note">
            文字是思考留下的足迹。
            <br />
            愿每一次回看，都有新的发现。
          </p>
        </aside>
      </div>
    </main>
    <Footer />
  </body>
</html>
