---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, withBase } from "../consts";
import { getBlogPosts } from "../lib/posts";
const posts = await getBlogPosts();
const yearOf = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    timeZone: "Asia/Shanghai",
  });
const shortDate = (date: Date) =>
  date.toLocaleDateString("zh-CN", {
    month: "2-digit",
    day: "2-digit",
    timeZone: "Asia/Shanghai",
  });
const years = [...new Set(posts.map((post) => yearOf(post.data.pubDate)))];
---

<!doctype html>
<html lang="zh-CN" id="top">
  <head>
    <BaseHead
      title={`文章归档 · ${SITE_TITLE}`}
      description="沿着时间线，回看每一次记录。"
    />
  </head>
  <body>
    <Header />
    <main id="main" class="wrap page">
      <div class="list-width">
        <p class="eyebrow">ALONG THE WAY</p>
        <h1>文章归档</h1>
        <p class="page-lead">{posts.length} 篇记录，慢慢积累。</p>
        {years.map((year) => (
          <section class="archive-group">
            <h2 class="archive-year">{year}</h2>
            <div>
              {posts
                .filter((post) => yearOf(post.data.pubDate) === year)
                .map((post) => (
                  <a class="archive-item" href={withBase(`blog/${post.id}/`)}>
                    <time datetime={post.data.pubDate.toISOString()}>
                      {shortDate(post.data.pubDate)}
                    </time>
                    <span>{post.data.title}</span>
                  </a>
                ))}
            </div>
          </section>
        ))}
      </div>
    </main>
    <Footer />
  </body>
</html>
